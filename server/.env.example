# Environment configuration
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb url  

# JWT configuration
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Admin login (only a password is required)
ADMIN_PASSWORD=Admin123

# Admin email (used for the forgot-password flow; must match an existing admin)
ADMIN_EMAIL=admin@nicecards.com

# Client origin for CORS (comma-separated list allowed; e.g. https://yoursite.netlify.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Cloudflare R2 (S3-compatible) storage for product images (free tier).
# Create a bucket, enable public access (r2.dev or a custom domain) and generate
# an S3 API token. When these are left empty, images fall back to base64 in MongoDB.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=nicecards-images
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
# Product images are uploaded to Cloudflare R2 and only the URL is kept in MongoDB.
